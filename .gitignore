# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# are not meant to be included in the repository.

# Rails
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Bundler
/.bundle
/vendor/bundle

# Environment / secrets
.env
.env.*
/config/master.key
/config/credentials/development.key
/config/credentials/test.key

# Assets / node (this app has no Node frontend; keep leftovers out)
/node_modules
/public/assets

# SQLite
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3-journal

# Tests / coverage
/coverage
/capybara-*.html
/tmp/screenshots

# OS / editor
.DS_Store
*~
*.swp
.idea
.vscode
