<% page_title "Explore — PWA Store" %>

<header class="store-header mobile-brand">
  <h1 class="page-title">Explore</h1>
  <span class="avatar" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8">
      <circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.6-3 4-4.5 7-4.5S17.4 16 19 19"/>
    </svg>
  </span>
</header>
<%= render "shared/search_form" %>
<%= render "shared/chips", active: @category, path: explore_path %>

<% if @collections.any? && @category == "all" %>
  <h2 class="section-title">Collections</h2>
  <% @collections.each do |collection| %>
    <%= link_to search_path(q: collection.title.split.first.downcase), class: "card collection-row" do %>
      <div class="collection-mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 12a5 5 0 0 1 8.5-3.5M17 12a5 5 0 0 1-8.5 3.5"/></svg>
      </div>
      <div class="app-row-copy">
        <h3><%= collection.title %></h3>
        <p><%= Listing.listings_for(collection.slugs).map(&:name).join(", ") %></p>
      </div>
      <span aria-hidden="true">›</span>
    <% end %>
  <% end %>
<% end %>

<% @groups.each do |category, listings| %>
  <h2 class="section-title"><%= category_label(category) %></h2>
  <% if category == "media" %>
    <div class="media-rail">
      <% listings.each do |listing| %>
        <%= link_to app_path(listing.slug), class: "media-card" do %>
          <div class="media-card-art">
            <img src="<%= listing.screenshots.dig(0, "src") || listing.icon %>" alt="">
          </div>
          <footer>
            <img class="app-icon" src="<%= listing.icon %>" alt="">
            <strong><%= listing.name %></strong>
          </footer>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card app-list <%= "productivity-grid" if category == "productivity" %>">
      <% listings.each do |listing| %>
        <%= render "shared/app_row", listing: listing %>
      <% end %>
    </div>
  <% end %>
<% end %>
